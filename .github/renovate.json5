{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    'security:openssf-scorecard',
    ':dependencyDashboard',
    ':semanticCommits',
  ],
  timezone: 'America/New_York',
  schedule: [
    'before 6am',
  ],
  minimumReleaseAge: '14 days',
  internalChecksFilter: 'strict',
  configMigration: true,
  labels: [
    'dependencies',
  ],
  assignees: [
    'NX1X',
  ],
  reviewers: [
    'NX1X',
  ],
  dependencyDashboard: {
    enabled: true,
    title: 'Dependency Dashboard',
    labels: [
      'dependencies',
    ],
    autoclose: true,
  },
  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  prCreation: 'immediate',
  rangeStrategy: 'bump',
  separateMultipleMajor: true,
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: '0 days',
    labels: [
      'dependencies',
      'security',
    ],
  },
  osvVulnerabilityAlerts: true,
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 6am on monday',
    ],
  },
  packageRules: [
    {
      description: 'GitHub Actions: SHA-pinned, grouped minor/patch/digest into one PR',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'github-actions',
      labels: [
        'dependencies',
        'github-actions',
      ],
    },
    {
      description: 'GitHub Actions majors: dedicated label, reviewed individually',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'github-actions',
        'major-update',
      ],
    },
    {
      description: 'Any major update: extra cooldown + clear label so it never slips by',
      matchUpdateTypes: [
        'major',
      ],
      minimumReleaseAge: '21 days',
      labels: [
        'dependencies',
        'major-update',
      ],
    },
    {
      description: 'Go modules: group minor/patch into one review PR; majors stay separate',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'go modules',
      labels: [
        'dependencies',
        'go',
      ],
    },
    {
      description: 'Go toolchain / go directive bumps reviewed on their own',
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'golang',
      ],
      labels: [
        'dependencies',
        'go',
        'toolchain',
      ],
    },
    {
      description: 'Base image updates (Dockerfile) pinned by digest, reviewed individually',
      matchManagers: [
        'dockerfile',
      ],
      labels: [
        'dependencies',
        'docker',
      ],
    },
    {
      description: "Helm chart: never pin the chart's own image (tag comes from appVersion)",
      matchManagers: [
        'helm-values',
      ],
      matchPackageNames: [
        'ghcr.io/nx1x/egret-nest',
      ],
      enabled: false,
    },
    {
      description: 'Go toolchain: go directive, setup-go go-version and golang images in ONE PR',
      matchDepNames: [
        'go',
        'golang',
      ],
      allowedVersions: '!/^1\\.27\\.[012](-|$)/',
      groupName: 'go toolchain',
      labels: [
        'dependencies',
        'go',
        'toolchain',
      ],
    },
  ],
  ignorePaths: [
    '**/vendor/**',
    '**/bin/**',
    '**/build/**',
    '**/dist/**',
  ],
}
